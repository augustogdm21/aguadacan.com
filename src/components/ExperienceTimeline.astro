---
const experiences = [
  {
    title: "Senior Frontend Engineer",
    company: "Tech Innovators",
    period: "2022 - Presente",
    description: "Liderazgo técnico en proyectos de gran escala, implementando arquitecturas modernas con React y Astro."
  },
  {
    title: "Fullstack Developer",
    company: "Creative Studio",
    period: "2020 - 2022",
    description: "Desarrollo de sitios web altamente interactivos para clientes internacionales del sector creativo."
  },
  {
    title: "Desarrollador Junior",
    company: "Startup Local",
    period: "2018 - 2020",
    description: "Inicios en el mundo del desarrollo web, trabajando con HTML, CSS y JavaScript moderno."
  }
];

const education = [
  {
    title: "Ingeniería Mecatrónica",
    institution: "Tecnológico de Estudios Superiores de Monterrey",
    period: "En curso",
    description: "Especialización en sistemas de control y diseño mecánico, integrando electrónica avanzada y programación de sistemas embebidos."
  }
];

const languages = [
  { name: "Inglés", level: "C1 - Avanzado" },
  { name: "Alemán", level: "A1 - Inicial" },
  { name: "Español", level: "Nativo" }
];
---
<section id="experiencia" class="py-20">
  <div class="grid md:grid-cols-3 gap-12">
    <div class="md:col-span-2">
      <h2 class="text-3xl font-bold mb-12 flex items-center gap-4 text-slate-100">
        <span class="text-cyan-500">01.</span> Experiencia Profesional
      </h2>
      
      <div class="space-y-12">
        {experiences.map((exp) => (
          <div class="relative pl-8 before:absolute before:left-0 before:top-0 before:bottom-0 before:w-px before:bg-slate-800 group hover:before:bg-cyan-500 transition-colors">
            <div class="absolute left-[-4px] top-0 w-2 h-2 rounded-full bg-slate-800 group-hover:bg-cyan-500 transition-colors"></div>
            <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-2">
              <h3 class="text-xl font-semibold text-slate-200 group-hover:text-slate-100 transition-colors">
                {exp.title} <span class="text-slate-500 font-normal">@ {exp.company}</span>
              </h3>
              <span class="text-sm font-medium text-slate-500">{exp.period}</span>
            </div>
            <p class="text-slate-400 leading-relaxed max-w-2xl italic">
              {exp.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-12">
      <div>
        <h2 class="text-2xl font-bold mb-8 flex items-center gap-4 text-slate-100">
          Educación
        </h2>
        {education.map((edu) => (
          <div class="mb-6 group">
            <h4 class="text-slate-200 font-semibold group-hover:text-slate-100 transition-colors">{edu.title}</h4>
            <p class="text-sm text-cyan-500 mb-2 font-medium">{edu.institution}</p>
            <p class="text-sm text-slate-500 mb-2">{edu.period}</p>
            <p class="text-sm text-slate-400 leading-relaxed italic">{edu.description}</p>
          </div>
        ))}
      </div>

      <div>
        <h2 class="text-2xl font-bold mb-8 flex items-center gap-4 text-slate-100">
          Idiomas
        </h2>
        <div class="space-y-4">
          {languages.map((lang) => (
            <div class="flex items-center justify-between group border-b border-slate-900 pb-2">
              <span class="text-slate-400 group-hover:text-slate-300 transition-colors">{lang.name}</span>
              <span class="text-xs font-mono px-2 py-1 bg-cyan-500/10 text-cyan-400 rounded border border-cyan-500/20 font-bold">{lang.level}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
