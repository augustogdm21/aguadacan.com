---
const experiences = [
  {
    title: "Senior Frontend Engineer",
    company: "Tech Innovators",
    period: "2022 - Presente",
    description: "Liderazgo técnico en proyectos de gran escala, implementando arquitecturas modernas con React y Astro."
  },
  {
    title: "Fullstack Developer",
    company: "Creative Studio",
    period: "2020 - 2022",
    description: "Desarrollo de sitios web altamente interactivos para clientes internacionales del sector creativo."
  },
  {
    title: "Desarrollador Junior",
    company: "Startup Local",
    period: "2018 - 2020",
    description: "Inicios en el mundo del desarrollo web, trabajando con HTML, CSS y JavaScript moderno."
  }
];
---
<section id="experiencia" class="py-20">
  <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
    <span class="text-cyan-400">01.</span> Experiencia Profesional
  </h2>
  
  <div class="space-y-12">
    {experiences.map((exp) => (
      <div class="relative pl-8 before:absolute before:left-0 before:top-0 before:bottom-0 before:w-px before:bg-slate-700 group hover:before:bg-cyan-500 transition-colors">
        <div class="absolute left-[-4px] top-0 w-2 h-2 rounded-full bg-slate-700 group-hover:bg-cyan-500 transition-colors"></div>
        <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-2">
          <h3 class="text-xl font-semibold text-slate-100 group-hover:text-cyan-400 transition-colors">
            {exp.title} <span class="text-slate-500 font-normal">@ {exp.company}</span>
          </h3>
          <span class="text-sm font-medium text-slate-500">{exp.period}</span>
        </div>
        <p class="text-slate-400 leading-relaxed max-w-2xl">
          {exp.description}
        </p>
      </div>
    ))}
  </div>
</section>
