---
---
<section id="contacto" class="py-20">
  <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
    <span class="text-cyan-400">02.</span> Contacto
  </h2>
  
  <div class="grid md:grid-cols-2 gap-12">
    <div>
      <p class="text-slate-400 mb-8 leading-relaxed">
        ¿Tienes algún proyecto en mente o simplemente quieres saludar? Mi bandeja de entrada siempre está abierta.
      </p>
      
      <div class="space-y-4">
        <a href="mailto:guadarrama.augusto@gmail.com" class="flex items-center gap-4 text-slate-300 hover:text-cyan-400 transition-colors group">
          <div class="p-3 bg-slate-800 rounded-lg group-hover:bg-cyan-400/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          guadarrama.augusto@gmail.com
        </a>
        
        <div class="flex gap-4 pt-4">
          <a href="https://github.com/augustogdm21" target="_blank" class="p-3 bg-slate-800 rounded-lg text-slate-300 hover:text-cyan-400 hover:bg-cyan-400/10 transition-all">
            <span class="sr-only">GitHub</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
    
    <form class="space-y-4">
      <div>
        <label for="name" class="block text-sm font-medium text-slate-400 mb-2">Nombre</label>
        <input type="text" id="name" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 focus:outline-none focus:border-cyan-500 transition-colors text-slate-200" placeholder="Tu nombre">
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate-400 mb-2">Email</label>
        <input type="email" id="email" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 focus:outline-none focus:border-cyan-500 transition-colors text-slate-200" placeholder="tu@email.com">
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-slate-400 mb-2">Mensaje</label>
        <textarea id="message" rows="4" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 focus:outline-none focus:border-cyan-500 transition-colors text-slate-200" placeholder="¿En qué puedo ayudarte?"></textarea>
      </div>
      <button type="submit" class="w-full py-3 bg-cyan-500 text-slate-950 font-bold rounded-lg hover:bg-cyan-400 transition-colors">
        Enviar Mensaje
      </button>
    </form>
  </div>
</section>
