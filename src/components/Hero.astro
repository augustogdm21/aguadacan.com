---
---
<section class="py-20 flex flex-col lg:flex-row items-center justify-between min-h-[70vh] gap-12">
  <div class="flex-1 w-full">
    <span class="reveal reveal-delay-1 px-3 py-1 text-xs font-semibold tracking-wider text-[var(--color-30)] uppercase bg-transparent border border-[var(--color-30)]/20 mb-6 inline-block">
      Disponible para nuevos retos
    </span>
    <h1 class="reveal reveal-delay-2 text-5xl md:text-7xl xl:text-8xl font-bold tracking-tight mb-6 leading-[1.2] pb-2 text-[var(--color-30)]">
      Augusto <br />
      <span class="text-[var(--color-10)] italic pr-4">Guadarrama</span>
    </h1>
    <p class="reveal reveal-delay-3 text-lg md:text-xl text-[var(--color-30)] max-w-2xl leading-relaxed mb-10">
      Estudiante de <span class="text-[var(--color-30)] font-bold">Ingeniería Mecatrónica</span> con pasión por los sistemas de <span class="text-[var(--color-10)]">control y mecánica</span>. Combino conocimientos en electrónica y computación para desarrollar soluciones tecnológicas integrales.
    </p>
    <div class="reveal reveal-delay-4 flex flex-wrap gap-4">
      <a href="#contacto" class="px-8 py-3 bg-[var(--color-10)] text-[var(--color-60)] font-bold rounded-lg hover:brightness-110 transition-all hover:scale-105 shadow-lg shadow-[var(--color-10)]/10 text-center">
        Hablemos
      </a>
      <a href="#experiencia" class="px-8 py-3 bg-transparent text-[var(--color-30)] font-semibold rounded-lg hover:bg-[var(--color-30)]/5 transition-all border border-[var(--color-30)]/30 text-center">
        Ver Experiencia
      </a>
    </div>
  </div>

  <div class="reveal reveal-delay-5 flex-1 w-full lg:flex justify-end hidden">
    <div class="relative group animate-float">
      <div class="relative px-8 py-10 bg-transparent ring-1 ring-[var(--color-30)]/20 rounded-2xl leading-none flex items-center justify-center">
        <div class="space-y-6">
          <div class="flex items-center space-x-4">
            <div class="h-12 w-12 bg-transparent rounded-full flex items-center justify-center border border-[var(--color-30)]/20">
              <span class="text-[var(--color-30)] font-bold text-xl italic">M</span>
            </div>
            <p class="text-[var(--color-30)] text-sm italic">Ing. Mecatrónica</p>
          </div>
          <div class="flex items-center space-x-4">
            <div class="h-12 w-12 bg-transparent rounded-full flex items-center justify-center border border-[var(--color-30)]/20">
              <svg class="h-6 w-6 text-[var(--color-30)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4m12 0l-4-4m-4 4l4 4" />
              </svg>
            </div>
            <p class="text-[var(--color-30)] text-sm italic">Control & Mecánica</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

