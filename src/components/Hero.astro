---
---
<section class="py-20 flex flex-col md:flex-row items-center justify-between min-h-[70vh] gap-12">
  <div class="flex-1 animate-in fade-in slide-in-from-left-4 duration-1000">
    <span class="px-3 py-1 text-xs font-medium tracking-wider text-cyan-400 uppercase bg-cyan-400/10 rounded-full border border-cyan-400/20 mb-6 inline-block">
      Disponible para nuevos retos
    </span>
    <h1 class="text-5xl md:text-8xl font-bold tracking-tight mb-6 leading-tight">
      Augusto <br />
      <span class="bg-gradient-to-r from-cyan-400 to-purple-500 bg-clip-text text-transparent italic">Guadarrama</span>
    </h1>
    <p class="text-xl text-slate-400 max-w-xl leading-relaxed mb-10">
      Desarrollador enfocado en crear experiencias digitales excepcionales, minimalistas y altamente interactivas. Especializado en arquitectura de frontend y optimización de rendimiento.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="#contacto" class="px-8 py-3 bg-white text-slate-950 font-semibold rounded-lg hover:bg-slate-200 transition-all hover:scale-105 shadow-lg shadow-white/10">
        Hablemos
      </a>
      <a href="#experiencia" class="px-8 py-3 bg-slate-800 text-white font-semibold rounded-lg hover:bg-slate-700 transition-all border border-slate-700">
        Ver Experiencia
      </a>
    </div>
  </div>

  <div class="flex-1 hidden md:flex justify-end animate-in fade-in slide-in-from-right-4 duration-1000">
    <div class="relative group">
      <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-purple-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
      <div class="relative px-8 py-10 bg-slate-900 ring-1 ring-slate-800 rounded-2xl leading-none flex items-center justify-center">
        <div class="space-y-6">
          <div class="flex items-center space-x-4">
            <div class="h-12 w-12 bg-cyan-500/10 rounded-full flex items-center justify-center">
              <span class="text-cyan-400 font-bold text-xl">8+</span>
            </div>
            <p class="text-slate-300">Años de experiencia</p>
          </div>
          <div class="flex items-center space-x-4">
            <div class="h-12 w-12 bg-purple-500/10 rounded-full flex items-center justify-center">
              <svg class="h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4m12 0l-4-4m-4 4l4 4" />
              </svg>
            </div>
            <p class="text-slate-300">Tech Stack Moderno</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-in {
    animation: fade-in 1s ease-out forwards;
  }
</style>
